#include "config.hcodal"
#include "ca_defines.hcodal"

// -------------------------------------------------------------------------------------------------
// Decode stage
// -------------------------------------------------------------------------------------------------

event id : pipeline(pipe.ID)
{
    use dec;
    use id_output;

    semantics
    {

        uint32 id_instr_temp;
        bool cache_ready, cache_response;

        if_code.transport(CP_PHS_DATA, cache_ready, cache_response, id_instr_temp);

        // s_id_instr = r_id_clear ? NOP_INSTRUCTION : id_instr_temp;
        if (r_id_clear){

            s_id_instr = NOP_INSTRUCTION;

        } else if (r_id_stall){

            s_id_instr = r_id_instr_preserved;

            r_id_pc = r_id_pc_preserved;

        } else {

            s_id_instr = id_instr_temp;

        }


        //OPcode
            s_id_opc = s_id_instr[31..25] :: s_id_instr[14..12] :: s_id_instr[6..0];

            //first source reg
            s_id_rs1 = s_id_instr[19..15];

            //second source reg
            s_id_rs2 = s_id_instr[24..20];

            //destination reg
            s_id_rd = s_id_instr[11..7];

            //itype immediate decode
            s_id_immedi = (int32)(int12)s_id_instr[31..20];

            //btype
            s_id_immedb = ((int32)(int12)(s_id_instr[31..31]::s_id_instr[7..7]::s_id_instr[30..25]::s_id_instr[11..8])) << 1;

            //utype
            s_id_immedu = ((int32)(int20)(s_id_instr[31..12])) << 12;

            //stype
            s_id_immeds = (int32)(int12)(s_id_instr[31..25]::s_id_instr[11..7]);

            //jtype 
            s_id_immedj = ((int32)(int20)(s_id_instr[31..31]::s_id_instr[19..12]::s_id_instr[20..20]::s_id_instr[30..21])) << 1;

        //reg
        s_id_reg1 = rf_xpr.src1[s_id_rs1];
        s_id_reg2 = rf_xpr.src2[s_id_rs2];


        //PHASE 8 -- load hazard detection
        if ((r_ex_memops == MEM_LB || r_ex_memops == MEM_LBU || r_ex_memops == MEM_LH || r_ex_memops == MEM_LHU || r_ex_memops == MEM_LW) &&
            (r_ex_rd == s_id_rs1 || r_ex_rd == s_id_rs2) &&
            (r_ex_rd != 0))
            {
                s_id_loadhaz = 1;
            } else {
                s_id_loadhaz = 0;
            }

        //set stall
        s_id_stall = (s_ex_stall || s_id_loadhaz);

        // Decoder activation
        dec(s_id_opc);

        //6-1 multiplexor
        switch (s_id_imm_sel){
            case IMM_ITYPE:
                s_id_immed = s_id_immedi;
                break;

            case IMM_BTYPE:
                s_id_immed = s_id_immedb;
                break;

            case IMM_JTYPE:
                s_id_immed = s_id_immedj;
                break;

            case IMM_UTYPE:
                s_id_immed = s_id_immedu;
                break;

            case IMM_STYPE:
                s_id_immed = s_id_immeds;
                break;

            case IMM_NONE:
                break;

            default:
                s_id_immed = 0;
                break;
        }

        //PHASE 6 -- RFFCTL
        //RFF1 control
        if ((r_wb_rd == s_id_rs1) && (r_wb_rd != 0) && (r_wb_regwrite)) s_id_rff1_sel = RFF1_SELWB;
        else s_id_rff1_sel = RFF1_SELID;

        //RFF2 control
        if ((r_wb_rd == s_id_rs2) && (r_wb_rd != 0) && (r_wb_regwrite)) s_id_rff2_sel = RFF2_SELWB;
        else s_id_rff2_sel = RFF2_SELID;

        //RFF1 select
        switch (s_id_rff1_sel){
            case RFF1_SELID:
                s_id_sel1 = s_id_reg1;
                break;

            case RFF1_SELWB:
                s_id_sel1 = s_wb_res;
                break;

            default:
                s_id_sel1 = 0;
                break;
        }
        //RFF2 select
        switch (s_id_rff2_sel){
            case RFF2_SELID:
                s_id_sel2 = s_id_reg2;
                break;

            case RFF2_SELWB:
                s_id_sel2 = s_wb_res;
                break;

            default:
                s_id_sel2 = 0;
                break;
        }

        // Update the registers
        id_output();
    };
};
event id_output : pipeline(pipe.ID)
{

    semantics
    {
        // -----------------------------------------------------------------------------------------
        // Pipeline output
        // -----------------------------------------------------------------------------------------
        r_ex_pc = r_id_pc;
        r_ex_aluop = s_id_aluop;
        r_ex_regwrite = s_id_regwrite;
        r_ex_alusrc2 = s_id_alusrc2;
        r_ex_halt = s_id_halt;
        r_ex_immed = s_id_immed;
        r_ex_rd = s_id_rd;
        r_ex_instr = s_id_instr;

        //PHASE 6, source registers and data hazard
        r_ex_src1 = s_id_rs1;
        r_ex_reg1 = s_id_sel1;

        r_ex_src2 = s_id_rs2;
        r_ex_reg2 = s_id_sel2;

        //PHASE 7
        r_ex_alusrc1 = s_id_alusrc1;
        r_ex_brnchop = s_id_brnchop;
        r_ex_bradd = s_id_bradd;
        r_ex_rfwtsel = s_id_rfwt_sel;

        //PHASE 8
        r_id_pc_preserved = r_id_pc;
        r_id_instr_preserved = s_id_instr;

        r_ex_memops = s_id_memop;
    };
};

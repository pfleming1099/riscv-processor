#include "ca_defines.hcodal"
#include "config.hcodal"
#include "debug.hcodal"
// -------------------------------------------------------------------------------------------------
// Write-Back Stage
// -------------------------------------------------------------------------------------------------

event wb : pipeline(pipe.WB)
{
    semantics
    {
        //pc adder
        s_wb_pc4 = r_wb_pc + 4;

        //multiplexor
        switch(r_wb_rfwtsel){
            case RFWT_ALU:
                s_wb_res = r_wb_alu;
                break;

            case RFWT_PC:
                s_wb_res = s_wb_pc4;
                break;

            case RFWT_MEM:
                s_wb_res = r_wb_mem_result;
                break;

            default:
                //codasip_fatal(RFWT_ERROR, "RFWT error\n", opcode);
                s_wb_res = 0;
                break;
        }

        if ( r_wb_regwrite && (r_wb_rd != 0)){
            rf_xpr.wrt0[r_wb_rd] = s_wb_res;
            codasip_info( 3, "rf_xpr [%d] = 0x%x", r_wb_rd, r_wb_alu );
        }

        // Set local stall.
        s_wb_stall = 0;

    };
};

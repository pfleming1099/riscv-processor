#include "ca_defines.hcodal"
#include "debug.hcodal"

// -------------------------------------------------------------------------------------------------
// Execute Stage
// -------------------------------------------------------------------------------------------------
event ex : pipeline(pipe.EX)
{
    use ex_output;
    use ex_memory;

    semantics
    {   
        // HALT instruction detection
        if (r_ex_halt == HALT_HALT)
        {
            codasip_break();
            codasip_info(INFO_GENERAL, "Halt Instructions Indicated");
        }

        //FWDCTL block logic
        //fwdA
        if ((r_me_rd == r_ex_src1) && (r_me_rd != 0) && (r_me_regwrite)) s_ex_fwdA_sl = FWDA_MERD;      //foward from mem stage
        else if ((r_wb_rd == r_ex_src1) && (r_wb_rd != 0) && (r_wb_regwrite)) s_ex_fwdA_sl = FWDA_WBRD; //foward from wb stage
        else s_ex_fwdA_sl = FWDA_EXREG1;  //register file source

        //fwdB
        if ((r_me_rd == r_ex_src2) && (r_me_rd != 0) && (r_me_regwrite)) s_ex_fwdB_sl = FWDB_MERD;      //foward from mem stage
        else if ((r_wb_rd == r_ex_src2) && (r_wb_rd != 0) && (r_wb_regwrite)) s_ex_fwdB_sl = FWDB_WBRD; //foward from wb stage
        else s_ex_fwdB_sl = FWDB_EXREG2;  //register file

        //select fwdA
        switch (s_ex_fwdA_sl){
            case FWDA_MERD:
                s_ex_mux1 = r_me_alu;
                break;
            
            case FWDA_WBRD:
                s_ex_mux1 = s_wb_res;
                break;

            case FWDA_EXREG1:
                s_ex_mux1 = r_ex_reg1;
                break;

            default:
                s_ex_mux1 = 0;
                break;
        }

        //select fwdB
        switch (s_ex_fwdB_sl){
            case FWDB_MERD:
                s_ex_mux2 = r_me_alu;
                break;
            
            case FWDB_WBRD:
                s_ex_mux2 = s_wb_res;
                break;

            case FWDB_EXREG2:
                s_ex_mux2 = r_ex_reg2;
                break;

            default:
                s_ex_mux2 = 0;
                break;
        }

        switch (r_ex_alusrc1){
            case ALU1_REG:
                s_ex_src1 = s_ex_mux1;
                break;

            case ALU1_ZERO:
                s_ex_src1 = 0;
                break;

            case ALU1_PC:
                s_ex_src1 = r_ex_pc;
                break;

            default:
                s_ex_src1 = -1;
                //codasip_fatal(SRC2_ERROR, "Default case: %d\n", r_ex_alusrc1);
                break;
        }

        switch (r_ex_alusrc2){
            case ALU2_REG:
                s_ex_src2 = s_ex_mux2;
                break;

            case ALU2_IMM:
                s_ex_src2 = r_ex_immed;
                break;

            default:
                s_ex_src2 = 0;
                codasip_fatal(SRC2_ERROR, "Default case: %d\n", r_ex_alusrc2);
                break;
        }

        switch (r_ex_aluop) {
            //Nop
            case ALU_NOP:
                s_ex_alu = 0;
                break;
            //add
            case ALU_ADD:
                s_ex_alu = s_ex_src1 + s_ex_src2;
                break;

            case ALU_AND:
                s_ex_alu = s_ex_src1 & s_ex_src2;
                break;

            case ALU_SUB:
                s_ex_alu = s_ex_src1 - s_ex_src2;
                break;

            case ALU_OR:
                s_ex_alu = s_ex_src1 | s_ex_src2;
                break;

            case ALU_XOR:
                s_ex_alu = s_ex_src1 ^ s_ex_src2;
                break;

            case ALU_SLT:
                if ((int32)s_ex_src1 < (int32)s_ex_src2) s_ex_alu = 1;
                else s_ex_alu = 0;
                break;

            case ALU_SLTU:
                if (s_ex_src1 < s_ex_src2) s_ex_alu = 1;
                else s_ex_alu = 0;
                break;

            case ALU_SLL:
                s_ex_alu = s_ex_src1 << s_ex_src2;
                break;

            case ALU_SRL:
                s_ex_alu = s_ex_src1 >> (uint5)s_ex_src2;
                break;

            case ALU_SRA:
                s_ex_alu = (int32)s_ex_src1 >> (uint5)s_ex_src2;
                break;

            case ALU_ENC:
                //0 1 3 4 6 8 10 11 13 15
                s_ex_p1 = s_ex_src1[0..0] ^ s_ex_src1[1..1] ^ s_ex_src1[3..3] ^ s_ex_src1[4..4] ^ s_ex_src1[6..6] ^ s_ex_src1[8..8] ^ s_ex_src1[10..10] ^ s_ex_src1[11..11] ^ s_ex_src1[13..13] ^ s_ex_src1[15..15];
                //0 2 3 5 6 9 10 12 13
                s_ex_p2 = s_ex_src1[0..0] ^ s_ex_src1[2..2] ^ s_ex_src1[3..3] ^ s_ex_src1[5..5] ^ s_ex_src1[6..6] ^ s_ex_src1[9..9] ^ s_ex_src1[10..10] ^ s_ex_src1[12..12] ^ s_ex_src1[13..13];
                //1 2 3 7 8 9 10 14 15
                s_ex_p4 = s_ex_src1[1..1] ^ s_ex_src1[2..2] ^ s_ex_src1[3..3] ^ s_ex_src1[7..7] ^ s_ex_src1[8..8] ^ s_ex_src1[9..9] ^ s_ex_src1[10..10] ^ s_ex_src1[14..14] ^ s_ex_src1[15..15];
                //4 5 6 7 8 9 10
                s_ex_p8 = s_ex_src1[4..4] ^ s_ex_src1[5..5] ^ s_ex_src1[6..6] ^ s_ex_src1[7..7] ^ s_ex_src1[8..8] ^ s_ex_src1[9..9] ^ s_ex_src1[10..10];
                //11 12 13 14 15
                s_ex_p16 = s_ex_src1[11..11] ^ s_ex_src1[12..12] ^ s_ex_src1[13..13] ^ s_ex_src1[14..14] ^ s_ex_src1[15..15];
                //all
                s_ex_p32 = s_ex_p1 ^ s_ex_p2 ^ s_ex_src1[0..0] ^ s_ex_p4 ^ s_ex_src1[1..1] ^ s_ex_src1[2..2] ^ s_ex_src1[3..3] ^ s_ex_p8 ^ 
                            s_ex_src1[4..4] ^ s_ex_src1[5..5] ^ s_ex_src1[6..6] ^ s_ex_src1[7..7] ^ s_ex_src1[8..8] ^ s_ex_src1[9..9] ^ s_ex_src1[10..10] ^ s_ex_p16 ^ 
                            s_ex_src1[11..11] ^ s_ex_src1[12..12] ^ s_ex_src1[13..13] ^ s_ex_src1[14..14] ^ s_ex_src1[15..15];

                //concat ecc
                s_ex_ecc = s_ex_p32 :: s_ex_p16 :: s_ex_p8 :: s_ex_p4 :: s_ex_p2 :: s_ex_p1;

                s_ex_alu = s_ex_ecc :: s_ex_src1[15..0];

                break;

                case ALU_DEC:
                    //0 1 3 4 6 8 10 11 13 15 16(p1)
                    s_ex_p1 = s_ex_src1[0..0] ^ s_ex_src1[1..1] ^ s_ex_src1[3..3] ^ s_ex_src1[4..4] ^ s_ex_src1[6..6] ^ s_ex_src1[8..8] ^ s_ex_src1[10..10] ^ s_ex_src1[11..11] ^ s_ex_src1[13..13] ^ s_ex_src1[15..15] ^ s_ex_src1[16..16];
                    //0 2 3 5 6 9 10 12 13 17(p2)
                    s_ex_p2 = s_ex_src1[0..0] ^ s_ex_src1[2..2] ^ s_ex_src1[3..3] ^ s_ex_src1[5..5] ^ s_ex_src1[6..6] ^ s_ex_src1[9..9] ^ s_ex_src1[10..10] ^ s_ex_src1[12..12] ^ s_ex_src1[13..13] ^ s_ex_src1[17..17];
                    //1 2 3 7 8 9 10 14 15 18(p4)
                    s_ex_p4 = s_ex_src1[1..1] ^ s_ex_src1[2..2] ^ s_ex_src1[3..3] ^ s_ex_src1[7..7] ^ s_ex_src1[8..8] ^ s_ex_src1[9..9] ^ s_ex_src1[10..10] ^ s_ex_src1[14..14] ^ s_ex_src1[15..15] ^ s_ex_src1[18..18];
                    //4 5 6 7 8 9 10 19(p8)
                    s_ex_p8 = s_ex_src1[4..4] ^ s_ex_src1[5..5] ^ s_ex_src1[6..6] ^ s_ex_src1[7..7] ^ s_ex_src1[8..8] ^ s_ex_src1[9..9] ^ s_ex_src1[10..10] ^ s_ex_src1[19..19];
                    //11 12 13 14 15 20(p16)
                    s_ex_p16 = s_ex_src1[11..11] ^ s_ex_src1[12..12] ^ s_ex_src1[13..13] ^ s_ex_src1[14..14] ^ s_ex_src1[15..15] ^ s_ex_src1[20..20];
                    //all
                    s_ex_p32 = s_ex_src1[16..16] ^ s_ex_src1[17..17] ^ s_ex_src1[0..0] ^ s_ex_src1[18..18] ^ s_ex_src1[1..1] ^ s_ex_src1[2..2] ^ s_ex_src1[3..3] ^ s_ex_src1[19..19] ^ 
                                s_ex_src1[4..4] ^ s_ex_src1[5..5] ^ s_ex_src1[6..6] ^ s_ex_src1[7..7] ^ s_ex_src1[8..8] ^ s_ex_src1[9..9] ^ s_ex_src1[10..10] ^ s_ex_src1[20..20] ^ 
                                s_ex_src1[11..11] ^ s_ex_src1[12..12] ^ s_ex_src1[13..13] ^ s_ex_src1[14..14] ^ s_ex_src1[15..15] ^ s_ex_src1[21..21];

                    //concat ecc
                    s_ex_ecc = s_ex_p32 :: s_ex_p16 :: s_ex_p8 :: s_ex_p4 :: s_ex_p2 :: s_ex_p1;

                    //error state
                    switch(s_ex_ecc){
                        //no error
                        case 0:
                            s_ex_alu = (s_ex_src1 & 0xffff);
                            break;
                        //p1
                        case 33:
                            s_ex_alu = (s_ex_src1 & 0xffff) | 0x40000000;
                            break;
                        //p2
                        case 34:
                            s_ex_alu = (s_ex_src1 & 0xffff) | 0x40000000;
                            break;
                        //d0
                        case 35:
                            s_ex_alu = ((s_ex_src1 ^ 0x1) & 0xffff) | 0x40000000;
                            break;
                        //p4
                        case 36:
                            s_ex_alu = (s_ex_src1 & 0xffff) | 0x40000000;
                            break;
                        //d1
                        case 37:
                            s_ex_alu = ((s_ex_src1 ^ 0x2) & 0xffff) | 0x40000000;
                            break;
                        //d2
                        case 38:
                            s_ex_alu = ((s_ex_src1 ^ 0x4) & 0xffff) | 0x40000000;
                            break;
                        //d3
                        case 39:
                            s_ex_alu = ((s_ex_src1 ^ 0x8) & 0xffff) | 0x40000000;
                            break;
                        //p8
                        case 40:
                            s_ex_alu = (s_ex_src1 & 0xffff) | 0x40000000;
                            break;
                        //d4
                        case 41:
                            s_ex_alu = ((s_ex_src1 ^ 0x10) & 0xffff) | 0x40000000;
                            break;
                        //d5
                        case 42:
                            s_ex_alu = ((s_ex_src1 ^ 0x20) & 0xffff) | 0x40000000;
                            break;
                        //d6
                        case 43:
                            s_ex_alu = ((s_ex_src1 ^ 0x40) & 0xffff) | 0x40000000;
                            break;
                        //d7
                        case 44:
                            s_ex_alu = ((s_ex_src1 ^ 0x80) & 0xffff) | 0x40000000;
                            break;
                        //d8
                        case 45:
                            s_ex_alu = ((s_ex_src1 ^ 0x100) & 0xffff) | 0x40000000;
                            break;
                        //d9
                        case 46:
                            s_ex_alu = ((s_ex_src1 ^ 0x200) & 0xffff) | 0x40000000;
                            break;
                        //d10
                        case 47:
                            s_ex_alu = ((s_ex_src1 ^ 0x400) & 0xffff) | 0x40000000;
                            break;
                        //p16
                        case 48:
                            s_ex_alu = (s_ex_src1 & 0xffff) | 0x40000000;
                            break;
                        //d11
                        case 49:
                            s_ex_alu = ((s_ex_src1 ^ 0x800) & 0xffff) | 0x40000000;
                            break;
                        //d12
                        case 50:
                            s_ex_alu = ((s_ex_src1 ^ 0x1000) & 0xffff) | 0x40000000;
                            break;
                        //d13
                        case 51:
                            s_ex_alu = ((s_ex_src1 ^ 0x2000) & 0xffff) | 0x40000000;
                            break;
                        //d14
                        case 52:
                            s_ex_alu = ((s_ex_src1 ^ 0x4000) & 0xffff) | 0x40000000;
                            break;
                        //d15
                        case 53:
                            s_ex_alu = ((s_ex_src1 ^ 0x8000) & 0xffff) | 0x40000000;
                            break;
                        //p32
                        case 32:
                            s_ex_alu = (s_ex_src1 & 0xffff) | 0x40000000;
                            break;

                        default:
                            s_ex_alu = 0x80000000;
                            break;
                    }
                    break;
 
            default:
                s_ex_alu = 0;
                //codasip_fatal(ALU_ERROR, "Default case: %d line 74 /ca_pipe3_ex.codal\n", r_ex_aluop);
                break;
        }

        //branch address
        s_ex_brimm = r_ex_pc + r_ex_immed;

        switch (r_ex_bradd){
            case BRADD_ALU:
                s_ex_taddr = s_ex_alu;
                break;

            case BRADD_ADDR:
                s_ex_taddr = s_ex_brimm;
                break;
        }

        //zero
        if (s_ex_alu == 0) s_ex_zero = 1;
        else s_ex_zero = 0;

        // Timing
        ex_memory();
        ex_output();
    };
};

event ex_memory : pipeline(pipe.EX)
{
    semantics
    {
        uint1 op_rw;        //read/write
        uint2 op_type;      //non-seq/burst/idle

        switch (r_ex_memops){
            case MEM_NOP:
                op_rw = DONT_CARE;
                op_type = CP_AHB_IDLE;
                s_ex_memsize = DONT_CARE;
                break;

            case MEM_LB:
                op_rw = CP_AHB_READ;
                op_type = CP_AHB_NONSEQ;
                s_ex_memsize = CP_AHB_SIZE_8;
                break;

            case MEM_LBU:
                op_rw = CP_AHB_READ;
                op_type = CP_AHB_NONSEQ;
                s_ex_memsize = CP_AHB_SIZE_8;
                break;

            case MEM_LH:
                op_rw = CP_AHB_READ;
                op_type = CP_AHB_NONSEQ;
                s_ex_memsize = CP_AHB_SIZE_16;
                break;

            case MEM_LHU:
                op_rw = CP_AHB_READ;
                op_type = CP_AHB_NONSEQ;
                s_ex_memsize = CP_AHB_SIZE_16;
                break;

            case MEM_LW:
                op_rw = CP_AHB_READ;
                op_type = CP_AHB_NONSEQ;
                s_ex_memsize = CP_AHB_SIZE_32;
                break;

            case MEM_SB:
                op_rw = CP_AHB_WRITE;
                op_type = CP_AHB_NONSEQ;
                s_ex_memsize = CP_AHB_SIZE_8;
                break;

            case MEM_SH:
                op_rw = CP_AHB_WRITE;
                op_type = CP_AHB_NONSEQ;
                s_ex_memsize = CP_AHB_SIZE_16;
                break;

            case MEM_SW:
                op_rw = CP_AHB_WRITE;
                op_type = CP_AHB_NONSEQ;
                s_ex_memsize = CP_AHB_SIZE_32;
                break;

            default:
                op_rw = DONT_CARE;
                op_type = CP_AHB_IDLE;
                s_ex_memsize = DONT_CARE;
                break;
        }

        //call transport function
        ldst.transport(CP_PHS_ADDRESS, op_type, op_rw, s_ex_alu, s_ex_memsize);
        s_ex_encoded_data = ldst.encode_data(s_ex_mux2 , s_ex_alu, s_ex_memsize);

        //stall signal assignment
        s_ex_stall = s_me_stall;
    };
};

event ex_output : pipeline(pipe.EX)
{
    semantics
    {
        r_me_pc = r_ex_pc;
        r_me_alu = s_ex_alu;
        r_me_regwrite = r_ex_regwrite;
        r_me_rd = r_ex_rd;
        r_me_instr = r_ex_instr;

        //PHASE 7
        r_me_brnchop = r_ex_brnchop;
        r_me_target_addr = s_ex_taddr;
        r_me_rfwtsel = r_ex_rfwtsel;
        r_me_zero = s_ex_zero;

        //PHASE 8
        r_me_memsize = s_ex_memsize;
        r_me_wtdat = s_ex_encoded_data;
        r_me_memops = r_ex_memops;
    };
};

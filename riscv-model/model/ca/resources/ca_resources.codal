#include "ca_defines.hcodal"
#include "config.hcodal"

#define BOOLEAN_BIT     1    // Boolean control bit of width 1-bit
#define TWO_BIT         2       // Two bit wide control signal

pipeline pipe
{
    IF, ID, EX, ME, WB
};

// -------------------------------------------------------------------------------------------------
// Fetch stage
// -------------------------------------------------------------------------------------------------

signal bit[ADDR_W] s_if_nextpc;
signal bit[ADDR_W] s_if_pcin;

// -------------------------------------------------------------------------------------------------
// Decode stage
// -------------------------------------------------------------------------------------------------

// Program Counter
register bit[ADDR_W] r_id_pc                { pipeline = pipe.ID; };

//phase 8
register bit[WORD_W] r_id_stall             { default = false; };

register bit[WORD_W] r_id_instr_preserved;   //reg no pipeline definitions
register bit[WORD_W] r_id_pc_preserved;      //reg no pipeline definitions

// Instruction -- Machine Code
signal bit[INSTR_W] s_id_instr;

// ALU Operation Control
signal bit[ALUOP_W] s_id_aluop;

//Control Signals
signal bit[REGWRITE_W] s_id_regwrite;
signal bit[SRC1_W] s_id_alusrc1;    //phase7
signal bit[SRC2_W] s_id_alusrc2;
signal bit[HALT_W] s_id_halt;


//Instruction opcode + func3 + func7
signal bit[OPC_W] s_id_opc;

//Regfile read
signal bit[IMM5_W] s_id_rs1;
signal bit[IMM5_W] s_id_rs2;

signal bit[WORD_W] s_id_reg1;
signal bit[WORD_W] s_id_reg2;

signal bit[IMM5_W] s_id_rd;

signal bit[WORD_W] s_id_immed;

signal bit[RFF1_W] s_id_rff1_sel;
signal bit[RFF2_W] s_id_rff2_sel;

signal bit[WORD_W] s_id_sel1;
signal bit[WORD_W] s_id_sel2;

// signal bit[WORD_W] s_id_src1;
// signal bit[WORD_W] s_id_src2;

//phase 7
signal bit[IMMTYPE_W] s_id_imm_sel;

signal bit[BRANCHOP_W] s_id_brnchop;

signal bit[RFWT_W] s_id_rfwt_sel;

signal bit[BRADD_W] s_id_bradd;

signal bit[WORD_W] s_id_immedi;
signal bit[WORD_W] s_id_immedb;
signal bit[WORD_W] s_id_immedu;
signal bit[WORD_W] s_id_immeds;
signal bit[WORD_W] s_id_immedj;

//phase 8
signal bit[MEMOPS_W] s_id_memop;        //memory operation control logic
signal bit[BOOLEAN_BIT] s_id_loadhaz;   //load hazard indication



// -------------------------------------------------------------------------------------------------
// Execute stage
// -------------------------------------------------------------------------------------------------

// Pipelined Program Counter + Instruction
register bit[ADDR_W] r_ex_pc            		{ pipeline = pipe.EX; };
register bit[INSTR_W] r_ex_instr                { pipeline = pipe.EX; };
register bit[HALT_W] r_ex_halt            		{ pipeline = pipe.EX; };

// ALU Operation Control
register bit[ALUOP_W] r_ex_aluop        		{ pipeline = pipe.EX; };

register bit[WORD_W] r_ex_reg1                  { pipeline = pipe.EX; };
register bit[WORD_W] r_ex_reg2                  { pipeline = pipe.EX; };

register bit[SRC1_W] r_ex_alusrc1               { pipeline = pipe.EX; };    //phase 7
register bit[WORD_W] r_ex_alusrc2               { pipeline = pipe.EX; };

register bit[WORD_W] r_ex_immed                 { pipeline = pipe.EX; };

register bit[REGWRITE_W] r_ex_regwrite          { pipeline = pipe.EX; };

register bit[WORD_W] r_ex_rd                    { pipeline = pipe.EX; };

register bit[WORD_W] r_ex_src1                  { pipeline = pipe.EX; };
register bit[WORD_W] r_ex_src2                  { pipeline = pipe.EX; };

register bit[BRANCHOP_W] r_ex_brnchop           { pipeline = pipe.EX; };
register bit[BRADD_W] r_ex_bradd                { pipeline = pipe.EX; };   

register bit[RFWT_W] r_ex_rfwtsel               { pipeline = pipe.EX; };

register bit[MEMOPS_W] r_ex_memops              { pipeline = pipe.EX; };


//register bit[WORD_W] r_ex_instr                 { pipeline = pipe.EX; };

//signals
signal bit[WORD_W] s_ex_src1;
signal bit[WORD_W] s_ex_src2;

signal bit[WORD_W] s_ex_alu;

signal bit[FWDA_W] s_ex_fwdA_sl;
signal bit[FWDB_W] s_ex_fwdB_sl;

signal bit[WORD_W] s_ex_mux1;
signal bit[WORD_W] s_ex_mux2;

signal bit[BOOLEAN_BIT] s_ex_zero;

signal bit[BRANCHOP_W] s_ex_brnchop;
signal bit[BRADD_W] s_ex_bradd;
signal bit[WORD_W] s_ex_brimm;
signal bit[WORD_W] s_ex_taddr;

signal bit[RFWT_W] s_ex_rfwtsel;

//phase 8
signal bit[2] s_ex_memsize;         //size of memory operation
signal bit[WORD_W] s_ex_encoded_data;   //retirmed va;ie fpr tje decpde data function - used in mem stage

//phase 9 -- parity
signal bit[1] s_ex_p1;
signal bit[1] s_ex_p2;
signal bit[1] s_ex_p4;
signal bit[1] s_ex_p8;
signal bit[1] s_ex_p16;
signal bit[1] s_ex_p32;

signal bit[WORD_W] s_ex_ecc;

// -------------------------------------------------------------------------------------------------
// Memory stage
// -------------------------------------------------------------------------------------------------

// Pipelined Program Counter + Instruction
register bit[ADDR_W] r_me_pc           			{ pipeline = pipe.ME; };
register bit[INSTR_W] r_me_instr                { pipeline = pipe.ME; };
register bit[WORD_W] r_me_alu                   { pipeline = pipe.ME; };
register bit[WORD_W] r_me_regwrite              { pipeline = pipe.ME; };
register bit[WORD_W] r_me_rd                    { pipeline = pipe.ME; };

register bit[BRANCHOP_W] r_me_brnchop           { pipeline = pipe.ME; };
register bit[BRADD_W] r_me_bradd                { pipeline = pipe.ME; };
register bit[RFWT_W] r_me_rfwtsel               { pipeline = pipe.ME; };

register bit[BOOLEAN_BIT] r_me_zero             { pipeline = pipe.ME; };

register bit[WORD_W] r_me_target_addr           { pipeline = pipe.ME; };

register bit[2] r_me_memsize                    { pipeline = pipe.ME; };
register bit[WORD_W] r_me_wtdat                 { pipeline = pipe.ME; };
register bit[MEMOPS_W] r_me_memops              { pipeline = pipe.ME; };

signal bit[BOOLEAN_BIT] s_me_pcsrc;

//phase 8
signal bit[WORD_W] s_me_decoded_data;
signal bit[WORD_W] s_me_mem_result;     //he formatted value for the decoded data that will be used in the MEM stage. Add all corresponding pipeline registers to pass the value all the way to the writeback stage

//signal bit[RFWT_W] s_me_rfwtsel;

// -------------------------------------------------------------------------------------------------
// Writeback stage
// -------------------------------------------------------------------------------------------------

// Pipelined Program Counter + Instruction
register bit[ADDR_W] r_wb_pc            		{ pipeline = pipe.WB; };
register bit[INSTR_W] r_wb_instr                { pipeline = pipe.WB; };
register bit[WORD_W] r_wb_rd                    { pipeline = pipe.WB; };
register bit[WORD_W] r_wb_alu                   { pipeline = pipe.WB; };
register bit[WORD_W] r_wb_regwrite              { pipeline = pipe.WB; };

register bit[RFWT_W] r_wb_rfwtsel               { pipeline = pipe.WB; };
register bit[WORD_W] r_wb_target_addr           { pipeline = pipe.WB; };
register bit[BOOLEAN_BIT] r_wb_zero             { pipeline = pipe.WB; };

register bit[WORD_W] r_wb_mem_result            { pipeline = pipe.WB; };

//register bit[W]


signal bit[WORD_W] s_wb_pc4;
signal bit[WORD_W] s_wb_res;

// -------------------------------------------------------------------------------------------------
// Pipeline control
// -------------------------------------------------------------------------------------------------

signal   bit[1] s_if_stall;
signal   bit[1] s_id_stall;
signal   bit[1] s_id_clear;
register bit[1] r_id_clear {default = true;};
signal   bit[1] s_ex_stall;
signal   bit[1] s_ex_clear;
signal   bit[1] s_me_stall;
signal   bit[1] s_me_clear;
signal   bit[1] s_wb_stall;
signal   bit[1] s_wb_clear;




// -------------------------------------------------------------------------------------------------
// SYSCALL support for simulation
// -------------------------------------------------------------------------------------------------
signal bit [BOOLEAN_BIT]            s_syscall_pending;
signal bit [BOOLEAN_BIT]            s_syscall_stall;
register bit [TWO_BIT]              r_syscall_delay         {default = 0;};

